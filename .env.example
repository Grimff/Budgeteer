# Copy this file to .env and fill it in. .env is git-ignored, so your keys never go to GitHub.
#   cp .env.example .env

# --- Plaid (bank sync) -------------------------------------------------------
# From https://dashboard.plaid.com/developers/keys
PLAID_CLIENT_ID=
PLAID_SECRET=
# sandbox = Plaid's test bank (use with your sandbox secret); production = real banks
PLAID_ENV=sandbox
# Optional: countries to show banks from (comma separated)
# PLAID_COUNTRIES=US
# Optional: needed only for OAuth banks, must be an https address registered in Plaid
# PLAID_REDIRECT_URI=

# --- App ---------------------------------------------------------------------
# Password for the web page, as user:password. Strongly recommended once bank sync is on.
BASIC_AUTH=
# Where the budget, bank data and Plaid tokens are saved. Relative paths are from the project folder.
# Docker ignores this and always uses /data inside the container (mapped to ./data by docker-compose.yml).
DATA_DIR=./data
# Port for `npm start` (Docker uses HOST_PORT below instead)
PORT=8095
# Port on your machine when running with Docker
HOST_PORT=8095
# Your time zone, like America/New_York (used for daily backups and "today")
TZ=UTC
# Days of daily backups to keep
BACKUPS_KEEP=90
# Hours between automatic bank syncs (until you pick a refresh time in Settings)
BANK_SYNC_HOURS=1
